<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CardGameStore</RootNamespace>
    <AssemblyName>CardGameStore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CardGameStore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL de inicialização (Data/InicializacaoBanco.cs) vai dentro da DLL -->
    <EmbeddedResource Include="Data\Inicializacao\*.sql" LogicalName="CardGameStore.Data.Inicializacao.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Authentication / JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />

    <!-- MongoDB -->
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <!-- Dependências do driver do Mongo presas em versões corrigidas (o 2.30 puxava Snappier 1.0.0
         — GHSA-pggp-6c3x-2xmx, alta — e SharpCompress 0.30.1 — GHSA-6c8g-7p36-r338). São as mesmas
         versões do MongoDB.Driver 3.13; a compressão na conexão com o Mongo não é usada. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />

    <!-- BCrypt -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

    <!-- SignalR (built into ASP.NET Core, but included for clarity) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />

    <!-- Fotos leves: miniatura WebP das fotos enviadas (Services/Implementations/FotosLeves.cs).
         O pacote Linux.NoDependencies traz a lib nativa sem precisar instalar nada na imagem Docker. -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />

    <!-- QR Code generation -->
    <PackageReference Include="QRCoder" Version="1.8.0" />

    <!-- Web Push / VAPID — notificações browser push -->
    <PackageReference Include="WebPush" Version="1.0.11" />
    <PackageReference Include="Zeus.Net.NFe.NFCe" Version="2026.6.30.1332" />

    <!-- BouncyCastle: leitura de PKCS#12 com algoritmos legados (RC2/3DES), comuns
         em certificados A1 ICP-Brasil mais antigos. O X509Certificate2 nativo do
         .NET no Linux delega ao OpenSSL do sistema, que desde a versão 3 desativa
         esses algoritmos por padrão — BouncyCastle implementa a decodificação em
         C# puro, sem depender de config nenhuma do SO.
         Versão fixada em 1.8.1.3 (mesma trazida transitivamente pelo Zeus.Net.NFe.NFCe)
         para não duplicar o assembly Org.BouncyCastle com versões conflitantes. -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.8.1.3" />
  </ItemGroup>

</Project>
