# =============================================================================
# .env — Variáveis de produção SantuárioNerd
# IMPORTANTE: renomeie este arquivo para .env e preencha TODOS os valores
# NUNCA commite o arquivo .env no Git!
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=cardgamestore
POSTGRES_USER=cardgame_user
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI   # ex: xK9#mPq2vL8@nR5

# -----------------------------------------------------------------------------
# JWT — chave secreta para assinar tokens de autenticação
# Gere com: openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=TROQUE_POR_CHAVE_JWT_AQUI

# -----------------------------------------------------------------------------
# E-mail (Resend) — https://resend.com
# O remetente ainda é @santuarionerd.tech: só troque para @santuarionerd.com.br
# depois de verificar o domínio novo no Resend (registros SPF/DKIM no DNS).
# Trocar antes disso derruba TODO e-mail transacional.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_XXXXXXXXXXXXXXXXXXXX    # API key do Resend
SMTP_FROM_EMAIL=noreply@santuarionerd.tech
SMTP_FROM_NAME="Santuário Nerd"

# URL pública do site — usada nos links dos e-mails (reset de senha, etc.)
APP_URL=https://santuarionerd.com.br

# -----------------------------------------------------------------------------
# Integrações
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXX
POKEMON_API_KEY=

# Web Push do Chrome/Firefox. Gere uma vez no projeto e copie o par exibido:
# dotnet run --project CardGameStore -- gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@santuarionerd.com.br

# -----------------------------------------------------------------------------
# WhatsApp comunitário — Evolution API + n8n
# Gere cada chave separadamente: openssl rand -hex 32
# EVOLUTION_DATABASE_URI exige caracteres especiais da senha em URL encoding.
# Exemplo: # vira %23, @ vira %40. Mantenha ?schema=evolution_api no final.
# -----------------------------------------------------------------------------
EVOLUTION_API_KEY=TROQUE_POR_CHAVE_EVOLUTION
EVOLUTION_INSTANCE_NAME=santuarionerd
EVOLUTION_DATABASE_URI=postgresql://cardgame_user:SENHA_URL_ENCODED@postgres:5432/cardgamestore?schema=evolution_api
WHATSAPP_AUTOMATION_API_KEY=TROQUE_POR_CHAVE_INTERNA_N8N_API
N8N_ENCRYPTION_KEY=TROQUE_POR_CHAVE_N8N

# -----------------------------------------------------------------------------
# Segurança
# Gere com: openssl rand -hex 32
# -----------------------------------------------------------------------------
IP_HASH_SALT=TROQUE_POR_SALT_AQUI

# -----------------------------------------------------------------------------
# Criptografia de dados sensíveis em repouso (senha de certificado, client
# secrets do Inter/Mercado Pago, tokens OAuth) — AES-256-GCM.
# Gere com: openssl rand -base64 32
# NUNCA troque depois do primeiro deploy — tudo que já foi salvo criptografado
# com a chave antiga vira ilegível pra sempre (erro "authentication tag did
# not match" nos logs é exatamente isso). Faça backup deste valor.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=TROQUE_POR_CHAVE_GERADA_AQUI
